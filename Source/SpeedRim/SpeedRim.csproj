<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>SpeedRim</AssemblyName>
    <RootNamespace>SpeedRim</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <Description>Extra game speeds (5x / 10x / 20x) for RimWorld 1.6</Description>

    <!-- The compiled assembly must land in <ModFolder>/1.6/Assemblies so RimWorld loads it. -->
    <OutputPath>$(MSBuildProjectDirectory)/../../1.6/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)/obj/</BaseIntermediateOutputPath>

    <!-- Only SpeedRim.dll should end up in Assemblies: RimWorld provides everything else. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <Deterministic>true</Deterministic>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- RimWorld 1.6 reference assemblies (compile-time only, never shipped). -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" ExcludeAssets="runtime" PrivateAssets="all" />
    <!-- Harmony is provided at runtime by the Harmony mod (brrainz.harmony). -->
    <PackageReference Include="Lib.Harmony" Version="2.3.6" ExcludeAssets="runtime" PrivateAssets="all" />
    <!-- Lets the project build with the .NET SDK on Linux/macOS as well as on Windows. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
